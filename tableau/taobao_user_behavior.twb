      <column caption="buy/pv" datatype="real" name="[Calculation_5809676007256067]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF SUM([pv]) = 0 THEN NULL ELSE SUM([buy]) / SUM([pv]) END" />
