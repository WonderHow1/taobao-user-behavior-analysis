      <column caption="(cart+fav)/pv" datatype="real" name="[Calculation_5809676007571460]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF SUM([pv]) = 0 THEN NULL ELSE (SUM([cart]) + SUM([fav])) / SUM([pv]) END" />
